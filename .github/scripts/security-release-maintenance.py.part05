    });
    await expectExternalLink(support, {
      href: "https://buymeacoffee.com/devpeter",
      label: "Support FeatherText on Buy Me a Coffee",
    });
'''
if old_e2e not in e2e:
    raise RuntimeError("E2E footer block did not match")
write(e2e_path, e2e.replace(old_e2e, new_e2e, 1))

