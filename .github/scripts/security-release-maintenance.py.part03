    '      this.sourceWrap.classList.add("feather-hidden");\n',
    1,
)
core = core.replace(
    '      this.syncOriginal(this.editor.innerHTML);\n',
    '      this.syncOriginal(applied);\n',
    1,
)
core = core.replace(
    '      const template = this.document.createElement("template");\n'
    '      template.innerHTML = this.source.value;\n'
    '      text = template.content.textContent || "";\n',
    '      text = htmlToText(this.source.value, { document: this.document });\n',
    1,
)
core = core.replace(
    '    const html = value == null ? "" : String(value);\n'
    '    this.editor.innerHTML = this.renderSourceToHTML(html);\n'
    '    this.source.value = html;\n'
    '    this.syncOriginal(html);\n',
    '    const html = value == null ? "" : String(value);\n'
    '    const applied = replaceElementHTML(\n'
    '      this.editor,\n'
    '      this.renderSourceToHTML(html),\n'
    '      { document: this.document },\n'
    '    );\n'
    '    this.source.value = applied;\n'
    '    this.syncOriginal(applied);\n',
    1,
)
core = core.replace(
    '    this.editor.innerHTML = this.renderSourceToHTML(this.source.value);\n'
    '    this.sourceMutated("api:paste-source");\n',
    '    replaceElementHTML(\n'
    '      this.editor,\n'
    '      this.renderSourceToHTML(this.source.value),\n'
    '      { document: this.document },\n'
    '    );\n'
    '    this.sourceMutated("api:paste-source");\n',
    1,
)
core = core.replace(
    '  setAttribution(attribution, supportLink = this.config.supportLink) {\n'
    '    return this.setConfig({\n'
    '      attribution: !!attribution,\n'
    '      supportLink: !!supportLink,\n'
    '    });\n'
    '  }\n',
    '  setAttribution() {\n'
    '    return this.setConfig({ attribution: true, supportLink: true });\n'
    '  }\n',
    1,
)
write("src/feathertext.js", core)

# Footer is permanent and canonical: counters + GitHub + Buy Me a Coffee cannot be disabled or redirected.
config = read("src/config.js")
needle = '''  if (overrides && typeof overrides === "object") {
    for (const [key, value] of Object.entries(overrides))
      result[key] = cloneConfigValue(key, value);
  }
  return result;
'''
replacement = '''  if (overrides && typeof overrides === "object") {
    for (const [key, value] of Object.entries(overrides))
      result[key] = cloneConfigValue(key, value);
  }
  result.wordCount = true;
  result.charCount = true;
  result.attribution = true;
  result.supportLink = true;
  result.projectUrl = PROJECT_URL;
  result.supportUrl = SUPPORT_URL;
  return result;
'''
if needle not in config:
    raise RuntimeError("config footer normalization did not match")
write("src/config.js", config.replace(needle, replacement, 1))

status = read("src/status.js")
status = re.sub(
    r'export function shouldBuildStatus\(config\) \{.*?\n\}',
    'export function shouldBuildStatus() {\n  return true;\n}',
    status,
    count=1,
    flags=re.S,
)
status = status.replace(
    '        iconMarkup.coffee,\n      );\n',
    '        iconMarkup.coffee,\n        "Buy Me a Coffee",\n      );\n',
    1,
)
write("src/status.js", status)

# Scoped public npm package metadata and release version.
pkg_path = ROOT / "package.json"
pkg = json.loads(pkg_path.read_text(encoding="utf-8"))
pkg["name"] = PACKAGE
pkg["version"] = VERSION
pkg_path.write_text(json.dumps(pkg, indent=2) + "\n", encoding="utf-8")

lock_path = ROOT / "package-lock.json"
lock = json.loads(lock_path.read_text(encoding="utf-8"))
