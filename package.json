{
  "name": "feathertext",
  "version": "0.2.0",
  "description": "A dependency-free, performance-first rich text editor with configurable themes and toolbars.",
  "type": "module",
  "main": "dist/feathertext.cjs",
  "module": "dist/feathertext.esm.js",
  "unpkg": "dist/feathertext.min.js",
  "exports": {
    ".": {
      "import": "./dist/feathertext.esm.js",
      "require": "./dist/feathertext.cjs"
    },
    "./css": "./dist/feathertext.css",
    "./dist/feathertext.css": "./dist/feathertext.css"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm test && npm run build",
    "prepublishOnly": "npm run check",
    "dev": "npx http-server -c-1 -p 5173",
    "release:prepare": "npm run check && git add dist && git commit -m \"chore: build dist\" || echo \"no dist changes\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiszterSoul/FeatherText.git"
  },
  "homepage": "https://misztersoul.github.io/FeatherText/",
  "bugs": {
    "url": "https://github.com/MiszterSoul/FeatherText/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "jsdom": "^24.1.0"
  },
  "keywords": [
    "rich-text",
    "editor",
    "lightweight",
    "wysiwyg",
    "dependency-free",
    "performance"
  ],
  "license": "MIT"
}
